# Supabase project credentials.
# Create a project at https://supabase.com, run the SQL in supabase/migrations/*.sql
# (then optionally supabase/seed.sql for demo data), and paste the values below.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# When Supabase env vars are not set, the app runs in DEMO MODE using the
# bundled sample data (src/lib/demo) so the UI can be explored without a
# database. Set to "false" to force real Supabase usage even in dev.
NEXT_PUBLIC_DEMO_MODE=auto
